# Copy this file to .env and adjust as needed. All settings are optional for local use.

PORT=3000
APP_URL=http://localhost:3000
# NODE_ENV=production

# Long random string used to sign session cookies. REQUIRED in production.
SESSION_SECRET=change-me-to-a-long-random-string
# Sign users out after this many minutes of inactivity.
SESSION_MINUTES=30

# Local SQLite database file (used when TURSO_DATABASE_URL is empty).
# DB_PATH=./data/uhs.db

# Hosted database (Turso) - required on Vercel, where files are not kept between requests.
# Added automatically when you connect Turso to the Vercel project.
# TURSO_DATABASE_URL=libsql://your-db-your-org.aws-eu-west-1.turso.io
# TURSO_AUTH_TOKEN=

# Load the demo accounts and data into an EMPTY database on first start (for demonstrations).
# SEED_DEMO=true

# Protects the /cron/reminders endpoint called by Vercel Cron. A long random string.
# CRON_SECRET=

# Clinic hours and booking rules (24-hour time, West Africa Time).
CLINIC_OPEN=08:00
CLINIC_CLOSE=16:00
SLOT_MINUTES=20
# Days the clinic runs consultations: 0=Sun ... 6=Sat
CLINIC_DAYS=1,2,3,4,5
MAX_DAYS_AHEAD=30

# Video service. meet.jit.si is free but limits embedded calls (see README).
# Use your own Jitsi server for production, e.g. JITSI_DOMAIN=meet.uhs.ui.edu.ng
JITSI_DOMAIN=meet.jit.si

# Email. Leave SMTP_HOST empty to only record emails in the Admin > Email outbox.
# Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_USER=resend, SMTP_PASS=<your Resend API key>,
# and MAIL_FROM must use a domain you have verified in Resend. Also set APP_URL to the real site address
# so password-reset links work.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=UHS Telemedicine <no-reply@uhsonline.com.ng>

# First administrator, created automatically on first start if no admin exists
# (not needed if you run `npm run seed`).
ADMIN_EMAIL=admin@uhs.ui.edu.ng
ADMIN_PASSWORD=ChangeMe123

# Set when running behind a reverse proxy (nginx, etc.) that terminates HTTPS.
# TRUST_PROXY=1
