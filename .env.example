# Copy this file to .env and adjust as needed. All settings are optional for local use.

PORT=3000
APP_URL=http://localhost:3000
# NODE_ENV=production

# Long random string used to sign session cookies. REQUIRED in production.
SESSION_SECRET=change-me-to-a-long-random-string
# Sign users out after this many minutes of inactivity.
SESSION_MINUTES=30

# SQLite database file location.
# DB_PATH=./data/uhs.db

# Clinic hours and booking rules (24-hour time, West Africa Time).
CLINIC_OPEN=08:00
CLINIC_CLOSE=16:00
SLOT_MINUTES=20
# Days the clinic runs consultations: 0=Sun ... 6=Sat
CLINIC_DAYS=1,2,3,4,5
MAX_DAYS_AHEAD=30

# Video service. meet.jit.si is free but limits embedded calls (see README).
# Use your own Jitsi server for production, e.g. JITSI_DOMAIN=meet.uhs.ui.edu.ng
JITSI_DOMAIN=meet.jit.si

# Email. Leave SMTP_HOST empty to only record emails in the Admin > Email outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=UHS Telemedicine <no-reply@uhs.ui.edu.ng>

# First administrator, created automatically on first start if no admin exists
# (not needed if you run `npm run seed`).
ADMIN_EMAIL=admin@uhs.ui.edu.ng
ADMIN_PASSWORD=ChangeMe123

# Set when running behind a reverse proxy (nginx, etc.) that terminates HTTPS.
# TRUST_PROXY=1
