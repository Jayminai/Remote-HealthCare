{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["dub1"],
  "functions": {
    "api/index.js": {
      "includeFiles": "{src/**,public/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "crons": [{ "path": "/cron/reminders", "schedule": "0 6 * * *" }],
  "git": { "deploymentEnabled": { "main": false } }
}
