{
  "name": "remote-healthcare",
  "version": "1.0.0",
  "description": "Telemedicine platform for remote healthcare consultations – case study: University Health Service (UHS), University of Ibadan",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "seed": "node --env-file-if-exists=.env src/db/seed.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jayminai/Remote-HealthCare.git"
  },
  "keywords": [
    "telemedicine",
    "healthcare",
    "appointments",
    "electronic-medical-records",
    "university-health-service"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Jayminai/Remote-HealthCare/issues"
  },
  "homepage": "https://github.com/Jayminai/Remote-HealthCare#readme",
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.3",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "nodemailer": "^10.3.0"
  }
}
