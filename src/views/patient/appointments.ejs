<%- include('../partials/head') %>
<div class="page-head">
  <h1>My appointments</h1>
  <a class="btn" href="/patient/book">Book a consultation</a>
</div>
<div class="card">
  <% if (!list.length) { %>
    <p class="empty">You have not booked any appointments yet.</p>
  <% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>When</th><th>Type</th><th>Doctor</th><th>Reason</th><th>Status</th><th></th></tr></thead>
    <tbody>
    <% list.forEach((a) => { %>
      <tr>
        <td><%= t.fmtDateTime(a.scheduled_at) %></td>
        <td><%- include('../partials/mode', { m: a.mode }) %></td>
        <td><%= a.doctor_name || 'Next available' %></td>
        <td><%= a.reason %><% if (a.cancel_reason && a.status === 'cancelled') { %><br><small><%= a.cancel_reason %></small><% } %></td>
        <td><%- include('../partials/status', { s: a.status }) %></td>
        <td>
          <div class="row">
            <% if (a.canJoin) { %><a class="btn btn-accent btn-sm" href="/consult/<%= a.id %>">Join</a><% } %>
            <% if (a.status === 'booked') { %>
              <form method="post" action="/patient/appointments/<%= a.id %>/cancel" data-confirm="Cancel this appointment?">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-danger btn-sm" type="submit">Cancel</button>
              </form>
            <% } %>
          </div>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
  <% } %>
</div>
<%- include('../partials/foot') %>
