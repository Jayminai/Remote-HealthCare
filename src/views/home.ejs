<%- include('partials/head', { fullWidth: true }) %>
<section class="hero2">
  <div class="wrap">
    <span class="tagline">Welcome to UHS Telemedicine</span>
    <h1>See a UHS Doctor Without the Queue</h1>
    <p>Students, staff and their dependants can book appointments online, consult a doctor by video or audio call,
      and keep their medical records safe and easy to find.</p>
    <div class="row">
      <% if (currentUser) { %>
        <%# Staff and administrators who came from their portal's "Patient website" link (signed-in patients go to their dashboard). %>
        <a class="btn btn-accent btn-lg" href="<%= currentUser.role === 'admin' ? '/admin' : '/staff' %>">Back to the <%= currentUser.role === 'admin' ? 'admin' : 'staff' %> portal <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
      <% } else { %>
        <a class="btn btn-accent btn-lg" href="/register">Create a patient account <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        <a class="btn btn-light btn-lg" href="/login">Sign in</a>
      <% } %>
    </div>
    <div class="hero-badges">
      <span><i class="fa-solid fa-video" aria-hidden="true"></i> Video &amp; audio consultations</span>
      <span><i class="fa-solid fa-shield-heart" aria-hidden="true"></i> Secure electronic records</span>
      <span><i class="fa-regular fa-bell" aria-hidden="true"></i> Appointment reminders</span>
    </div>
  </div>
  <svg class="hero-wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true"><path d="M0,60 C240,100 480,20 720,40 C960,60 1200,95 1440,50 L1440,90 L0,90 Z"/></svg>
</section>
<%- include('partials/sections/about') %>
<%- include('partials/sections/services', { showAll: true }) %>
<%- include('partials/sections/how', { showGuide: true }) %>
<%- include('partials/sections/team') %>
<%- include('partials/sections/numbers') %>
<%- include('partials/sections/audience') %>
<%- include('partials/sections/faq') %>
<%- include('partials/foot') %>
