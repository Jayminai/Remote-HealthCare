<%- include('../partials/head') %>
<%# The heading and the list are refreshed in place when a new notification arrives (public/js/live.js). %>
<div class="page-head" id="notification-head" data-live-refresh="notifications">
  <h1><i class="fa-regular fa-bell h-icon" aria-hidden="true"></i>Notifications</h1>
  <% if (list.some((n) => !n.read_at)) { %>
    <form method="post" action="<%= base %>/notifications/read-all">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-light" type="submit"><i class="fa-solid fa-check-double" aria-hidden="true"></i> Mark all as read</button>
    </form>
  <% } %>
</div>
<div class="card" id="notification-list" data-live-refresh="notifications">
  <% if (!list.length) { %>
    <p class="empty">You have no notifications.</p>
  <% } else { %>
  <ul class="notice-list">
    <%# The whole notification is the link to what it is about. %>
    <% list.forEach((n) => { %>
      <li>
        <<%= n.link ? 'a' : 'div' %> class="notice <%= n.read_at ? '' : 'unread' %>"<% if (n.link) { %> href="<%= base %>/notifications/<%= n.id %>/open"<% } %>>
          <span class="notice-text">
            <%# Unread ones are tinted with a "New" tag; both clear once it is opened (live.js clears them at once). %>
            <span class="notice-title"><strong><%= n.title %></strong><% if (!n.read_at) { %><span class="tag-new" data-unread-tag>New</span><% } %></span>
            <span class="notice-body"><%= n.body %></span>
            <small class="muted"><%= t.fmtDateTime(n.created_at) %></small>
          </span>
          <% if (n.link) { %><i class="fa-solid fa-chevron-right notice-go" aria-hidden="true"></i><% } %>
        </<%= n.link ? 'a' : 'div' %>>
      </li>
    <% }) %>
  </ul>
  <% } %>
</div>
<%- include('../partials/foot') %>
