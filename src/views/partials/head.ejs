<%
  const role = currentUser ? currentUser.role : null;
  const links = {
    patient: [['/patient', 'Home'], ['/patient/book', 'Book'], ['/patient/appointments', 'Appointments'], ['/patient/records', 'My record'], ['/messages', 'Messages', unreadMessages]],
    doctor: [['/doctor', 'My queue'], ['/doctor/patients', 'Patients'], ['/messages', 'Messages', unreadMessages]],
    nurse: [['/records', 'Today'], ['/records/patients', 'Patients'], ['/records/patients/new', 'Register patient']],
    admin: [['/admin', 'Dashboard'], ['/admin/users', 'Users'], ['/admin/audit', 'Audit log'], ['/admin/outbox', 'Email outbox']],
  }[role] || [];
  // The active link is the longest one that matches the current path.
  const activeHref = links.map(([h]) => h)
    .filter((h) => currentPath === h || currentPath.startsWith(h + '/'))
    .sort((a, b) => b.length - a.length)[0];
  const isActive = (href) => href === activeHref;
  const roleNames = { patient: 'Patient', doctor: 'Doctor', nurse: 'Nurse / Records', admin: 'Administrator' };
%><!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · UHS Telemedicine</title>
  <link rel="icon" type="image/png" href="/static/img/ui-crest.png">
  <link rel="stylesheet" href="/static/css/style.css">
  <script src="/static/js/app.js" defer></script>
  <% (typeof scripts !== 'undefined' ? scripts : []).forEach((src) => { %>
  <script src="<%= src %>" defer></script>
  <% }) %>
</head>
<body>
<header class="topbar">
  <a class="brand" href="/"><img class="logo" src="/static/img/ui-crest.png" alt="" width="32" height="32"> UHS Telemedicine</a>
  <% if (currentUser) { %>
    <nav class="nav" aria-label="Main">
      <% links.forEach(([href, label, badge]) => { %>
        <a href="<%= href %>" class="<%= isActive(href) ? 'active' : '' %>"><%= label %><% if (badge) { %><span class="pill"><%= badge %></span><% } %></a>
      <% }) %>
      <a href="/notifications" class="<%= currentPath === '/notifications' ? 'active' : '' %>">Notifications<% if (unreadNotifications) { %><span class="pill"><%= unreadNotifications %></span><% } %></a>
    </nav>
    <div class="user-box">
      <span><a href="<%= role === 'patient' ? '/account/profile' : '/account/password' %>" style="color:#fff"><%= currentUser.full_name %></a> · <%= roleNames[role] %></span>
      <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">Sign out</button></form>
    </div>
  <% } else { %>
    <nav class="nav" aria-label="Main">
      <a href="/login" class="<%= currentPath === '/login' ? 'active' : '' %>">Sign in</a>
      <a href="/register" class="<%= currentPath === '/register' ? 'active' : '' %>">Create account</a>
    </nav>
  <% } %>
</header>
<main class="container">
<% if (flash) { %>
  <div class="alert alert-<%= flash.type %>" role="status"><%= flash.message %></div>
<% } %>
