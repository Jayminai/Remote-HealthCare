<%# Inner-page banner for the public pages. Needs: title. Optional: intro %>
<section class="page-banner">
  <div class="wrap">
    <h1><%= title %></h1>
    <% if (typeof intro !== 'undefined' && intro) { %><p><%= intro %></p><% } %>
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><i class="fa-solid fa-chevron-right" aria-hidden="true"></i><span aria-current="page"><%= title %></span>
    </nav>
  </div>
  <svg class="hero-wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true"><path d="M0,60 C240,100 480,20 720,40 C960,60 1200,95 1440,50 L1440,90 L0,90 Z"/></svg>
</section>
