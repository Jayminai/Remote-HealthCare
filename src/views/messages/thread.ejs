<%- include('../partials/head') %>
<% const isPatient = currentUser.role === 'patient'; %>
<% const otherName = isPatient ? doctor.full_name : patient.full_name; %>
<%# On phones this page fills the screen like a messaging app: the header and the message box stay put and only
    the messages scroll (see .chat-screen in style.css). %>
<div class="page-head chat-head">
  <a class="btn btn-light chat-back" href="<%= base %>/messages" aria-label="All messages"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i><span> All messages</span></a>
  <div class="chat-title">
    <h1><%= otherName %></h1>
    <% if (!isPatient) { %><span class="muted"><%= patient.uhs_number %> · <a href="/staff/patients/<%= patient.id %>">View record</a></span><% } %>
  </div>
  <%# Only the doctor can start a call, once the conversation has begun; the patient joins it from the banner below. %>
  <% if (!isPatient && patient.user_id && messages.length) { %>
    <div class="chat-actions">
      <% [['video', 'fa-video', 'Video call', 'Start a video call'], ['audio', 'fa-phone', 'Audio call', 'Start an audio call']].forEach(([mode, icon, label, action]) => { %>
        <form method="post" action="<%= base %>/messages/<%= patient.id %>/<%= doctor.id %>/call">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="mode" value="<%= mode %>">
          <button class="btn btn-light chat-call" type="submit" title="<%= action %>" aria-label="<%= action %>"><i class="fa-solid <%= icon %>" aria-hidden="true"></i><span> <%= label %></span></button>
        </form>
      <% }) %>
    </div>
  <% } %>
</div>
<div class="card narrow chat-card" style="max-width:820px">
  <%# A call in progress: shown and hidden live (public/js/live.js). %>
  <div class="call-banner" data-call-banner <%= call ? '' : 'hidden' %>>
    <span class="call-banner-icon" aria-hidden="true"><i class="fa-solid fa-phone-volume"></i></span>
    <span class="call-banner-text" data-call-text><%= call ? call.label : '' %></span>
    <a class="btn btn-accent btn-sm btn-live" data-call-join href="<%= call ? call.url : '#' %>"><i class="fa-solid <%= call && call.mode === 'audio' ? 'fa-phone' : 'fa-video' %>" aria-hidden="true"></i> <%= isPatient ? 'Join' : 'Rejoin' %></a>
    <% if (!isPatient) { %>
      <form method="post" data-call-end action="<%= call ? call.endUrl : '#' %>" data-confirm="End this call for both of you?">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-light btn-sm" type="submit"><i class="fa-solid fa-phone-slash" aria-hidden="true"></i> End</button>
      </form>
    <% } %>
  </div>
  <%# New messages, read receipts and "typing…" arrive without reloading (public/js/live.js). %>
  <div class="thread" data-thread="<%= base %>/messages/<%= patient.id %>/<%= doctor.id %>"
       data-last-id="<%= messages.length ? messages[messages.length - 1].id : 0 %>" aria-live="polite">
    <% if (!messages.length) { %><p class="empty" data-thread-empty>No messages yet. Say hello.</p><% } %>
    <% messages.forEach((m, i) => { %>
      <div class="msg <%= m.sender_id === currentUser.id ? 'mine' : '' %>" data-id="<%= m.id %>" <%- i === messages.length - 1 ? 'id="latest"' : '' %>>
        <% if (m.image_id) { const src = `${base}/messages/${patient.id}/${doctor.id}/images/${m.image_id}`; %>
          <a class="msg-photo" href="<%= src %>" target="_blank" rel="noopener"><img src="<%= src %>" alt="Photo" loading="lazy"></a>
        <% } %>
        <% if (m.body) { %><span class="body"><%= m.body %></span><% } %>
        <span class="meta"><%= t.fmtDateTime(m.created_at) %><% if (m.sender_id === currentUser.id) { %><span data-read <%= m.read_at ? '' : 'hidden' %>> · read</span><% } %></span>
      </div>
    <% }) %>
  </div>
  <p class="typing" data-typing hidden><span class="typing-dots" aria-hidden="true"><i></i><i></i><i></i></span> <%= otherName %> is typing…</p>
  <% if (!isPatient && !patient.user_id) { %>
    <div class="alert alert-info chat-notice">This patient has no online account. Please contact them by phone.</div>
  <% } else if (!doctor.is_active) { %>
    <div class="alert alert-info chat-notice">This doctor is no longer available on the platform.</div>
  <% } else { %>
  <form class="chat-composer" method="post" action="<%= base %>/messages/<%= patient.id %>/<%= doctor.id %>" data-message-form>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="alert alert-error" data-message-error role="alert" hidden></div>
    <%# Photo chosen to send, shown before sending (public/js/live.js). %>
    <div class="chat-attachment" data-photo-preview hidden>
      <img alt="Photo to send">
      <button type="button" class="chat-attachment-remove" data-photo-remove aria-label="Remove photo"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
    </div>
    <div class="chat-input">
      <%# Sending photos needs JavaScript, so the button only appears once live.js has loaded. %>
      <button type="button" class="btn btn-light chat-attach" data-photo-button hidden title="Send a photo" aria-label="Send a photo"><i class="fa-regular fa-image" aria-hidden="true"></i></button>
      <input type="file" accept="image/*,.heic,.heif,.hif,.tif,.tiff,.avif,.svg" data-photo-input hidden>
      <label for="body" class="sr-only">Your message</label>
      <textarea id="body" name="body" maxlength="2000" rows="1" placeholder="Type a message" required></textarea>
      <button class="btn chat-send" type="submit" aria-label="Send"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i><span> Send</span></button>
    </div>
    <% if (isPatient) { %><small class="muted chat-hint">Not for emergencies. For urgent problems go to the UHS emergency unit.</small><% } %>
  </form>
  <% } %>
</div>
<%- include('../partials/foot') %>
