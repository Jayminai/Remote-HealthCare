<%- include('../partials/head') %>
<% const roleNames = { doctor: 'Doctor', nurse: 'Nurse / Records officer', admin: 'Administrator' }; %>
<div class="page-head">
  <h1><i class="fa-regular fa-circle-user h-icon" aria-hidden="true"></i>My profile</h1>
  <a class="btn btn-light" href="<%= base %>/account/password"><i class="fa-solid fa-key" aria-hidden="true"></i> Change password</a>
</div>
<div class="grid grid-2">
  <div class="card">
    <h2><i class="fa-regular fa-id-card h-icon" aria-hidden="true"></i>Personal information</h2>
    <dl class="kv">
      <dt>Name</dt><dd><%= user.full_name %></dd>
      <dt>Email</dt><dd><%= user.email %></dd>
      <dt>Role</dt><dd><%= roleNames[user.role] || user.role %></dd>
      <% if (user.specialty) { %><dt>Specialty</dt><dd><%= user.specialty %></dd><% } %>
      <dt>Account created</dt><dd><%= t.fmtDate(user.created_at) %></dd>
      <dt>Last sign-in</dt><dd><%= user.last_login_at ? t.fmtDateTime(user.last_login_at) : '—' %></dd>
    </dl>
    <p class="muted" style="margin-top:1rem">To correct your name, email or role, please ask a UHS administrator.</p>
  </div>
  <div class="card">
    <h2><i class="fa-regular fa-address-book h-icon" aria-hidden="true"></i>Contact details</h2>
    <%- include('../partials/errors') %>
    <form method="post" action="<%= base %>/account/profile/staff" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="phone">Phone <span class="hint">(optional)</span></label>
        <input id="phone" type="tel" name="phone" value="<%= user.phone || '' %>">
      </div>
      <button class="btn" type="submit"><i class="fa-regular fa-floppy-disk" aria-hidden="true"></i> Save changes</button>
    </form>
  </div>
</div>
<%- include('../partials/foot') %>
