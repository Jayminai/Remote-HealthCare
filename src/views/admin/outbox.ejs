<%- include('../partials/head') %>
<div class="page-head">
  <div><h1>Email outbox</h1><span class="muted">Every email the system sends, newest first</span></div>
  <form method="post" action="/staff/admin/outbox/test">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn" type="submit"><i class="fa-regular fa-paper-plane" aria-hidden="true"></i> Send me a test email</button>
  </form>
</div>
<div class="card">
  <h2>Email settings</h2>
  <% if (smtpConfigured) { %>
    <dl class="kv">
      <dt>Status</dt><dd><span class="badge badge-ok">Sending enabled</span></dd>
      <dt>Mail server</dt><dd><%= smtpHost %></dd>
      <dt>Sent from</dt><dd><%= smtpFrom %></dd>
    </dl>
  <% } else { %>
    <p><span class="badge badge-warn">Not sending</span> No mail server is configured, so emails are only recorded below.
      Set the <code>SMTP_*</code> settings (for example with Resend) to send real emails — see the README.</p>
  <% } %>
  <p class="muted" style="margin-top:.8rem">Password reset links are hidden in this list for security.</p>
</div>
<div class="card">
  <div class="table-wrap"><table>
    <thead><tr><th>When</th><th>To</th><th>Subject</th><th>Message</th><th>Status</th></tr></thead>
    <tbody>
    <% emails.forEach((m) => { %>
      <tr>
        <td style="white-space:nowrap"><small><%= m.created_at %></small></td>
        <td><%= m.to_email %></td>
        <td><%= m.subject %></td>
        <td style="white-space:pre-wrap"><small><%= m.body %></small></td>
        <td><span class="badge <%= m.status === 'sent' ? 'badge-ok' : m.status === 'failed' ? 'badge-danger' : '' %>"><%= m.status %></span>
          <% if (m.error) { %><br><small><%= m.error %></small><% } %></td>
      </tr>
    <% }) %>
    <% if (!emails.length) { %><tr><td colspan="5" class="empty">No emails yet.</td></tr><% } %>
    </tbody>
  </table></div>
</div>
<%- include('../partials/foot') %>
