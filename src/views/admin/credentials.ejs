<%- include('../partials/head') %>
<div class="narrow card">
  <h1><%= title %></h1>
  <dl class="kv">
    <dt>Name</dt><dd><%= name %></dd>
    <dt>Website</dt><dd><%= appUrl %></dd>
    <dt>Email</dt><dd><%= email %></dd>
    <dt>Temporary password</dt><dd><span class="secret"><%= password %></span></dd>
  </dl>
  <div class="alert alert-warn" style="margin-top:1rem">
    Share this password privately. It is shown <strong>only once</strong> and must be changed at first sign-in.
  </div>
  <a class="btn" href="/admin/users">Back to users</a>
</div>
<%- include('../partials/foot') %>
