<%- include('../partials/head') %>
<div class="narrow card">
  <h1>Online access enabled</h1>
  <p><strong><%= patient.full_name %></strong> (<%= patient.uhs_number %>) can now sign in.</p>
  <dl class="kv">
    <dt>Website</dt><dd><%= appUrl %></dd>
    <dt>Email</dt><dd><%= email %></dd>
    <dt>Temporary password</dt><dd><span class="secret"><%= tempPassword %></span></dd>
  </dl>
  <div class="alert alert-warn" style="margin-top:1rem">
    Give this password to the patient privately (write it down for them). It is shown <strong>only once</strong>.
    They will be asked to choose a new password the first time they sign in.
  </div>
  <a class="btn" href="/patients/<%= patient.id %>">Back to patient record</a>
</div>
<%- include('../partials/foot') %>
