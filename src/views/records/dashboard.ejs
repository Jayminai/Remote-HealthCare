<%- include('../partials/head') %>
<%
  const waiting = list.filter((a) => a.status === 'checked_in').length;
  const pct = totals.total ? Math.round(((totals.digitised || 0) / totals.total) * 100) : 0;
%>
<div class="page-head">
  <div><h1>Records office</h1><span class="muted"><%= t.fmtDate(t.toDate()) %></span></div>
  <div class="row">
    <a class="btn" href="/records/patients/new">Register patient</a>
  </div>
</div>

<div class="stats">
  <div class="stat"><div class="value"><%= list.filter((a) => a.status !== 'cancelled').length %></div><div class="label">Appointments today</div></div>
  <div class="stat"><div class="value"><%= waiting %></div><div class="label">Waiting to be seen</div></div>
  <div class="stat"><div class="value"><%= totals.total %></div><div class="label">Patients on system</div></div>
  <div class="stat"><div class="value"><%= pct %>%</div><div class="label">Paper files digitised (<%= totals.digitised || 0 %>)</div></div>
  <div class="stat"><div class="value"><%= totals.online || 0 %></div><div class="label">With online access</div></div>
</div>

<div class="card">
  <h2>Find a patient (walk-in, phone booking, vitals)</h2>
  <form method="get" action="/records/patients" class="row">
    <input type="search" name="q" placeholder="Name, UHS number, matric/staff number, phone or old file number" style="flex:1; min-width:220px">
    <button class="btn" type="submit">Search</button>
  </form>
  <p class="muted" style="margin-top:.5rem">Always search before registering, to avoid creating a duplicate file.</p>
</div>

<div class="card">
  <div class="card-head"><h2>Today's queue</h2></div>
  <% if (!list.length) { %>
    <p class="empty">No appointments today yet.</p>
  <% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>Time</th><th>Patient</th><th>Type</th><th>Doctor</th><th>Status</th><th>Actions</th></tr></thead>
    <tbody>
    <% list.forEach((a) => { %>
      <tr>
        <td><%= a.scheduled_at.slice(11, 16) %><br><span class="badge"><%= { online: 'Online', phone: 'Phone', walk_in: 'Walk-in' }[a.booked_via] %></span></td>
        <td><a href="/patients/<%= a.patient_id %>"><%= a.patient_name %></a><br><small><%= a.uhs_number %></small></td>
        <td><%- include('../partials/mode', { m: a.mode }) %></td>
        <td><%= a.doctor_name || 'Any doctor' %></td>
        <td>
          <%- include('../partials/status', { s: a.status }) %>
          <% if (a.waitingMinutes != null) { %><br><small>waiting <%= a.waitingMinutes %> min</small><% } %>
        </td>
        <td>
          <div class="row">
            <% if (a.status === 'booked' && a.mode === 'in_person') { %>
              <form method="post" action="/records/appointments/<%= a.id %>/check-in">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-sm" type="submit">Check in</button>
              </form>
            <% } %>
            <% if (['booked', 'checked_in'].includes(a.status) && a.mode === 'in_person') { %>
              <a class="btn btn-light btn-sm" href="/patients/<%= a.patient_id %>?appointment=<%= a.id %>#vitals">Vitals</a>
            <% } %>
            <% if (a.isLate) { %>
              <form method="post" action="/records/appointments/<%= a.id %>/no-show" data-confirm="Mark as no-show?">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-danger btn-sm" type="submit">No-show</button>
              </form>
            <% } %>
            <% if (['booked', 'checked_in'].includes(a.status)) { %>
              <form method="post" action="/records/appointments/<%= a.id %>/cancel" data-confirm="Cancel this appointment? The patient will be notified.">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-danger btn-sm" type="submit">Cancel</button>
              </form>
            <% } %>
          </div>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
  <% } %>
</div>
<%- include('../partials/foot') %>
